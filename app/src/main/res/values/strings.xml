<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <!--
      ============================================================
      Echo Air — canonical English resource file (values/strings.xml)
      ============================================================
      All user-facing strings in the app. Translations live in
      values-es, values-zh, values-ja. Keep keys in this order when
      adding new ones so diffs stay manageable.

      Terminology rules (see brief):
        - Air Waybill: spell out on first reference, use "AWB" after.
        - Don't translate: commodity names, IATA codes, AWB numbers,
          device IDs/MACs, airline carrier names, unit symbols (°C, V,
          dBm), brand ("Echo Air", "Suply").
    -->

    <string name="app_name">Suply ECHO</string>

    <!-- ============ Home (guided landing page) ============ -->
    <!-- Headline: establishes that Echo Air works at any moment on the
         supply chain — origin, hub, in-transit handoff, arrival, audit.
         Not just an arrival-scan app. -->
    <!-- Home intro. Two paragraphs sitting above the action cards.
         [primary] tells the user what kind of identifier to provide
         (AWB / container / QR) and what'll happen when they do.
         [positioning] is operational: where to physically stand for
         the BLE scan to work. -->
    <string name="home_intro_primary">Enter an air waybill or container number, or scan any device QR code — we\'ll automatically identify and connect all devices in the shipment.</string>
    <string name="home_intro_positioning">Stand close to the cargo where the device is attached, at the container door, or beside the ULD or pallets.</string>
    <!-- Primary action card. AWB entry is the primary path because most
         users have the AWB number from shipping documents before they
         reach the cargo. -->
    <string name="home_action_awb_title">Enter your air waybill number</string>
    <string name="home_action_awb_subtitle">On the cargo paperwork or label</string>
    <!-- Ocean-reefer action card. Sits between AWB and QR — same shape
         as the AWB card, just for the container-number path. -->
    <string name="home_enter_container_number">Enter your container number</string>
    <string name="home_enter_container_number_help">From the paperwork or on the container itself</string>
    <!-- Tertiary action card. QR is faster if a QR is visible but
         doesn\'t require finding one — both paths reach the same
         destination. Single-line label (no subtitle on this card). -->
    <string name="home_scan_qr_button">Scan QR code of device</string>
    <!-- Reassurance footer addressing first-launch friction
         ("do I need to register? do I need an account?"). -->
    <string name="home_footer_no_account">No account needed. Your data is only shared with parties on this shipment.</string>
    <!-- Accessibility content description for the alternating hero
         illustration (single ULD ↔ multiple ULDs). Spoken by TalkBack;
         localised so it reads in the user\'s language. -->
    <string name="home_hero_image_description">A warehouse operator standing in front of air cargo containers, holding a phone.</string>
    <!-- Accessibility label for the language pill chip in the top-right. -->
    <string name="home_language_selector_label">Change language</string>

    <!-- ============ Settings ============ -->
    <string name="settings_title">Settings</string>
    <string name="settings_battery_optimisation">Disable battery optimisation</string>
    <string name="settings_language">Language</string>
    <string name="settings_debug_run_spike">Run kbeaconlib2 spike (debug)</string>

    <!-- ============ Language picker ============ -->
    <string name="language_picker_title">Language</string>
    <string name="language_name_en">English</string>
    <string name="language_name_es">Español</string>
    <string name="language_name_zh">简体中文</string>
    <string name="language_name_ja">日本語</string>
    <!-- First-launch confirmation. %1$s = native name of detected language -->
    <string name="language_first_launch_set_to">We\'ve set your language to %1$s.</string>
    <string name="language_first_launch_question">Is this correct?</string>
    <string name="language_first_launch_yes">Yes, continue</string>
    <string name="language_first_launch_change">Change language</string>

    <!-- ============ Capture (QR) ============ -->
    <string name="capture_title_qr">Scan device QR</string>
    <string name="capture_permission_grant">Grant camera permission</string>

    <!-- ============ Manual AWB entry ============ -->
    <string name="awb_title">Enter AWB</string>
    <string name="awb_heading">Enter the 11-digit air waybill number</string>
    <string name="awb_subheading">3-digit airline prefix, then 8-digit serial.</string>
    <string name="awb_unknown_prefix">Unknown airline prefix.</string>
    <!-- Check-digit mismatch. %1$d = expected digit. -->
    <string name="awb_check_digit_mismatch">Check digit doesn\'t match — double-check the last digit.</string>
    <string name="awb_check_digit_mismatch_expected">Check digit doesn\'t match — double-check the last digit (expected %1$d).</string>
    <string name="awb_continue">Continue</string>
    <!-- Submit button copy while the shipment lookup is in flight.
         Paired with a spinner; appears synchronously on tap so the
         user gets zero-latency feedback that the action registered. -->
    <string name="awb_continue_loading">Looking up shipment…</string>

    <!-- ============ Manual container-number entry (ocean reefer) ============ -->
    <string name="container_entry_title">Enter container number</string>
    <string name="container_entry_heading">Enter the 11-character container number</string>
    <string name="container_entry_subheading">4-letter owner code, 6-digit serial, 1-digit check.</string>
    <string name="container_entry_placeholder">ABCDU1234567</string>
    <string name="container_entry_validation_format">Container numbers are 4 letters followed by 7 digits.</string>
    <string name="container_entry_validation_checkdigit">Check digit doesn\'t match — double-check the last digit.</string>
    <!-- %1$d = expected check digit -->
    <string name="container_entry_validation_checkdigit_expected">Check digit doesn\'t match — double-check the last digit (expected %1$d).</string>

    <!-- ============ Confirm Shipment sheet ============ -->
    <string name="confirm_heading_low_confidence">Double-check this is your shipment</string>
    <string name="confirm_fallback_commodity">Shipment</string>
    <string name="confirm_label_air_waybill">Air Waybill</string>
    <string name="confirm_label_container_number">Container Number</string>
    <string name="confirm_badge_air_freight">Air freight</string>
    <string name="confirm_badge_ocean_reefer">Ocean reefer</string>
    <string name="confirm_no_devices_expected">No devices expected</string>
    <plurals name="confirm_devices_to_collect">
        <item quantity="one">1 device to collect</item>
        <item quantity="other">%1$d devices to collect</item>
    </plurals>
    <string name="confirm_start_scanning">Start scanning</string>
    <string name="common_cancel">Cancel</string>

    <!-- ============ System-state prompts (Bluetooth / Location services) ============ -->
    <!-- v0.5.9. Pre- and mid-collection gates: BLE scanning silently
         fails on Android when Bluetooth or location services are off,
         so the Collection screen surfaces an explicit prompt with a
         one-tap recovery action. Dialogs are modal — cancel routes
         the user back to home. -->
    <string name="system_bluetooth_off_title">Bluetooth is off</string>
    <string name="system_bluetooth_off_body">Bluetooth is required to collect device data. Please enable it to continue.</string>
    <string name="system_bluetooth_enable_action">Enable Bluetooth</string>
    <string name="system_location_off_title">Location services are off</string>
    <string name="system_location_off_body">Location services are required for Bluetooth scanning on Android. Please enable them to continue.</string>
    <string name="system_location_enable_action">Open Location Settings</string>
    <string name="common_ok">OK</string>

    <!-- ============ Collection screen ============ -->
    <!-- Title fallback while shipment is still loading -->
    <string name="collection_title_fallback">Collecting</string>
    <!-- Header "Collected: 2 of 6" -->
    <string name="collection_header_collected">Collected</string>
    <string name="collection_header_of">of</string>
    <!-- Per-device states -->
    <string name="collection_state_searching">Searching</string>
    <string name="collection_state_in_range">In range</string>
    <string name="collection_state_connecting">Connecting…</string>
    <string name="collection_state_syncing">Syncing</string>
    <string name="collection_state_finalising">Finalising…</string>
    <string name="collection_state_collected">Collected</string>
    <string name="collection_state_missing">Not detected</string>
    <string name="collection_state_error">Connection failed</string>
    <!-- "Syncing  42%" — %1$d is the integer percent -->
    <string name="collection_state_syncing_with_percent">Syncing  %1$d%%</string>
    <string name="collection_row_retry">Retry</string>
    <!-- "Device 633640" — %1$s is the device ID, do not translate the ID itself -->
    <string name="collection_row_device_id">Device %1$s</string>
    <string name="collection_alarm_on_device">Alarm on device</string>
    <!-- Proximity hints: appear inline on each SEARCHING device card.
         Level 0 is an always-on ambient prompt visible from the moment
         searching starts (preemptive, not reactive). Levels 1/2/3
         escalate at 5 / 20 / 60 seconds if the device still isn't
         found — each only shown if the previous didn't resolve it. -->
    <string name="collection_hint_ambient">Hold your phone near the shipment.</string>
    <string name="collection_hint_get_closer">Move closer — devices are usually inside the ULD.</string>
    <string name="collection_hint_check_device">Still searching. Check the device is inside the cargo and powered.</string>
    <string name="collection_hint_contact_shipper">Can\'t find this device. Contact your shipper if it may be missing.</string>
    <!-- Bottom bar -->
    <string name="collection_finish">All devices collected — finish</string>
    <!-- Status text shown when no expected-devices roster has loaded yet
         (totalCount == 0). Reads as activity, not action. -->
    <string name="collection_finding_devices">Finding devices…</string>
    <!-- Status text shown while devices are loaded but none collected yet. -->
    <string name="collection_collecting_label">Collecting…</string>
    <!-- Progress text shown while at least one device has been collected
         but others are still in flight. The bar is non-tappable in this
         state — the text is a status indicator, not a CTA.
         %1$d = collected, %2$d = total. -->
    <plurals name="collection_collecting_n_of_m">
        <item quantity="one">%1$d of %2$d collected</item>
        <item quantity="other">%1$d of %2$d collected</item>
    </plurals>
    <string name="collection_close_partial">Close shipment without remaining devices</string>

    <!-- ============ Multiple Package Shipment (MPS) ============ -->
    <!-- Air-cargo industry term for a shipment that carries multiple
         physically separate units (pallets, ULDs, lots) under a single
         AWB. Acronym MPS is universally recognised; full form on first
         reference, MPS on subsequent. Customer's stored unit label
         (e.g. "ULD 1", "Pallet A", "Lote-247") always renders verbatim
         and is never translated; only the system-generated copy below
         is localised. See the v0.4.9 brief vocabulary section. -->
    <string name="confirm_mps_badge">Multiple Package Shipment (MPS)</string>
    <!-- Confirm sheet summary line, e.g. "4 units · 8 devices total".
         %1$d = unit count, %2$d = total device count. -->
    <string name="confirm_mps_summary">%1$d units · %2$d devices total</string>
    <!-- Per-unit progress on the Collection screen unit headers.
         %1$d = collected on this unit, %2$d = total on this unit. -->
    <plurals name="collection_unit_progress">
        <item quantity="one">%1$d of %2$d collected</item>
        <item quantity="other">%1$d of %2$d collected</item>
    </plurals>
    <!-- Fallback label for the rare synthetic unit holding any device
         whose unit_id arrived null. Renders in place of unit.label. -->
    <string name="collection_unattributed_unit">Unattributed</string>
    <!-- Close-confirmation dialog -->
    <string name="collection_close_dialog_title_finish">Finish shipment?</string>
    <plurals name="collection_close_dialog_title_partial">
        <item quantity="one">Close without 1 device?</item>
        <item quantity="other">Close without %1$d devices?</item>
    </plurals>
    <string name="collection_close_dialog_body_partial">Missing devices will be recorded in the attestation pack.</string>
    <string name="collection_close_dialog_body_all">All expected devices have been collected.</string>
    <string name="collection_close_dialog_confirm">Close shipment</string>

    <!-- ============ Location opt-in (one-time rationale on Collection screen entry) ============ -->
    <string name="location_rationale_title">Attach location to each scan?</string>
    <string name="location_rationale_body">Echo Air attaches the scan location to the shipment\'s audit trail, so the timeline shows where each device was scanned. Your location is only captured when you scan a device.</string>
    <string name="location_rationale_accept">Allow</string>
    <string name="location_rationale_decline">Not now</string>

    <!-- ============ Failure dialogs (CaptureViewModel.Failure → copy) ============ -->
    <string name="failure_unreachable_title">Can\'t reach Suply servers</string>
    <string name="failure_unreachable_body">Check your internet connection, then try again.</string>
    <string name="failure_timeout_title">Suply servers aren\'t responding</string>
    <string name="failure_timeout_body">This usually clears up after a few seconds. Try again.</string>
    <string name="failure_server_title">Something went wrong</string>
    <!-- Body when the HTTP code is known (e.g. 500, 503). %1$d = HTTP status code -->
    <string name="failure_server_body_with_code">Suply returned an error (HTTP %1$d). Try again in a moment, or contact your shipper if it keeps happening.</string>
    <!-- Body when the code is 0 / unknown (non-HttpException throwable) -->
    <string name="failure_server_body_unknown">Unexpected error. Try again in a moment.</string>
    <string name="failure_malformed_title">Unexpected response from Suply</string>
    <string name="failure_malformed_body">The server responded in a shape the app didn\'t recognise — usually means the backend was updated without the app catching up. Ask your shipper to check the deployment.</string>
    <string name="failure_no_shipment_for_awb_title">No active shipment found</string>
    <!-- %1$s = AWB number, do not translate -->
    <string name="failure_no_shipment_for_awb_body">No active shipment was found for AWB %1$s. Double-check the number, or if the shipment has already been completed, contact your shipper.</string>
    <string name="failure_no_shipment_for_container_title">No active shipment found</string>
    <!-- %1$s = container number, do not translate -->
    <string name="failure_no_shipment_for_container_body">No active shipment was found for container %1$s. Double-check the number, or if the shipment has already been completed, contact your shipper.</string>
    <string name="failure_no_awb_in_image_title">Couldn\'t read the AWB</string>
    <string name="failure_no_awb_in_image_body">Try another angle or better lighting, or scan the device QR code instead.</string>
    <string name="failure_device_not_registered_title">Device not registered</string>
    <string name="failure_device_not_registered_body">This Echo Air device isn\'t registered in the system. Contact your shipper.</string>
    <string name="failure_device_not_assigned_title">Device not on an active shipment</string>
    <string name="failure_device_not_assigned_body">This device is registered but isn\'t currently assigned to an active shipment. Contact your shipper.</string>
    <string name="failure_unrecognised_qr_title">Unrecognised QR code</string>
    <string name="failure_unrecognised_qr_body">Make sure you\'re scanning the QR label printed on an Echo Air device.</string>
    <!-- Debug-only detail suffix, only visible in debug builds. %1$s = exception info. -->
    <string name="failure_debug_detail_suffix">\n\n[debug] %1$s</string>

    <!-- ============ Permission rationales ============ -->
    <string name="permission_camera_rationale">Echo Air needs camera access to identify shipments from their documents.</string>
    <string name="permission_ble_rationale">Echo Air needs Bluetooth permission to collect data from shipment loggers.</string>
    <string name="permission_location_rationale">Android requires location permission before it will scan for Bluetooth devices. Some phone manufacturers (Honor, Huawei, Xiaomi) require this even on newer Android versions. Echo Air does not read or use your location itself.</string>

    <!-- ============ Notification channels ============ -->
    <string name="notif_channel_collection">Active collection</string>
    <string name="notif_channel_sync">Data sync</string>
    <string name="notif_collection_title">Collecting shipment</string>
    <string name="notif_collection_body">Collecting shipment data</string>

    <!-- ============ Side-load update prompt ============ -->
    <!-- Shown once per cold launch (and only when the suply.ai latest-version
         endpoint reports a newer versionCode). Dismissible. Side-loaded users
         in regions without Play Store rely on this nudge to refresh. -->
    <string name="update_dialog_title">Update available</string>
    <!-- %1$s = new versionName, e.g. "1.8.0" -->
    <string name="update_dialog_body">Echo Air %1$s is available. Download it to get the latest features and fixes.</string>
    <!-- %1$s = new versionName, %2$s = release-notes line from the remote JSON -->
    <string name="update_dialog_body_with_notes">Echo Air %1$s is available.\n\n%2$s</string>
    <string name="update_dialog_download">Download</string>
    <string name="update_dialog_later">Later</string>

    <!-- ============ Debug / spike ============ -->
    <string name="spike_title">kbeaconlib2 spike</string>
    <string name="spike_field_mac_label">Device MAC (BC:57:29:1C:D6:A6)</string>
    <string name="spike_field_password_label">Password</string>
    <string name="spike_run">Run spike</string>
    <string name="spike_log_output">Log output</string>
</resources>
